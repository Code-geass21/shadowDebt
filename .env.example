# ----------------------------------------
# SHADOW DEBT - ENVIRONMENT VARIABLES
# ----------------------------------------
# INSTRUCTIONS: Copy this file, rename it to .env, 
# and fill in your actual secure values before starting the stack.

# --- Database Credentials ---
POSTGRES_USER=shadow_user
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_DB=shadowdebt

# --- Database Connection String ---
# Must match the credentials above. The host must be 'db' for Docker network routing.
DATABASE_URL=postgresql://shadow_user:your_secure_database_password@db:5432/shadowdebt

# --- Security ---
# Minimum 32 characters. Used for securing sessions and tokens.
SECRET_KEY=your_random_secret_string_here_min_32_chars
ENVIRONMENT=production

# --- Application Preferences ---
DEFAULT_CURRENCY=INR
ALERT_LEAD_DAYS=7
MAX_UPLOAD_MB=25

# --- Container Storage Paths ---
# Internal paths mapped via docker-compose volumes. Rarely need changing.
BACKUP_DIR=/app/backups
